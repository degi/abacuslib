    "test_node2.js": [
      "const fs = require('fs');",
      "",
      "// Extract the exact JSON from test_output.html",
      "const html = fs.readFileSync('test_output.html', 'utf8');",
      "const match = html.match(/<script type=\"application\\/json\" data-for=\"[^\"]+\">([^<]+)<\\/script>/);",
      "const widgetData = JSON.parse(match[1]);",
      "const params = widgetData.x;",
      "",
      "console.log('Params loaded successfully!');",
      "console.log('abacus version:', params.data.version);"
    ],
