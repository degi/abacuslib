#'
#' @param id
#' @param title
#' @param is_paginated
#'
#' @return
#' @export
#' @import excelR
#'
#' @examples
tabel_edit_ui <- function(id, title = "", is_paginated = F) {
ns <- NS(id)
vspace <- "30px"
if(is_paginated) vspace <- "90px"
div(style = "height:100%;overflow:auto;",
span(
div(
style = "float:right;",
actionButton(
ns("upload_btn"),
"",
icon = icon("upload"),
class = "toolbar_button"
)
|> tooltip(
"Upload data",
id = ns("upload_tt"),
options = list(customClass = "custom-tooltip")
)
) |>
popover(
title = div(icon("upload"), "Upload data"),
id = ns("upload_pop"),
fileInput(ns("upload_file"), NULL, accept = c(".csv"))
),
title
),
excelR::excelOutput(ns("table_edit"), height = paste0("calc(100% - ",vspace,")")))
}
